# ==================== DATABASE ====================
# Local development:
DATABASE_URL=postgresql://marine_user:marine_password@localhost:5432/marine
# Production (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==================== CLAUDE AI ====================
# Get your API key from https://console.anthropic.com
CLAUDE_API_KEY=your-claude-api-key-here

# ==================== SECURITY ====================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-generated-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=false

# Private owner sign-in. Set these in Render/local .env to create your access.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-private-password
OWNER_FULL_NAME=MarineOS Owner
OWNER_ROLE=super_admin
# Set true only when you intentionally want startup to reset the owner's password.
OWNER_UPDATE_PASSWORD_ON_STARTUP=false

# ==================== CORS ====================
# Local development:
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# Production (replace with your actual Vercel URL):
# CORS_ORIGINS=["https://your-project.vercel.app","http://localhost:5173"]

# ==================== API SETTINGS ====================
API_TITLE=Marine Document System API
API_VERSION=1.0.0

# ==================== LOGGING ====================
LOG_LEVEL=INFO
DEBUG=false
RELOAD=false

# ==================== EMAIL (optional) ====================
# If not set, subscription emails are silently skipped
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@yahoo.com
# EMAIL_PASSWORD=your-yahoo-app-password-here
# NOTIFY_EMAIL=your-email@yahoo.com
